<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RSVPMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RSVPMobile"
    xmlns:views="clr-namespace:RSVPMobile.Views"
    Title="RSVPMobile"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginView}"
        Route="LoginView" />
    
    <ShellContent
        Title="Sign UP"
        ContentTemplate="{DataTemplate views:SignupView}"
        Route="SignupView" />

    <ShellContent
        Title="HomePage"
        ContentTemplate="{DataTemplate views:AttendeeView}"
        Route="AttendeeView" />
 
    <TabBar >

        <Tab Title="Events" Icon="calendar_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardView}" />
        </Tab>

        <Tab Title="Attendees" Icon="users_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:AttendeeView}" />
        </Tab>

        <Tab Title="RSVP" Icon="rsvp_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:RSVPView}" />
        </Tab>

        <Tab Title="Profile" Icon="profile_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:ProfileView}" />
        </Tab>
    </TabBar>

</Shell>
