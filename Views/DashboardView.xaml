<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RSVPMobile.Models"
             x:Class="RSVPMobile.Views.DashboardView"
             Title="DashboardView"
             Shell.NavBarIsVisible="False">

    <!-- Modern Gradient Background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0F0F1A" Offset="0.0"/>
            <GradientStop Color="#1A1A2E" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="*">

        <!-- Pull to Refresh -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDashboardDataCommand}">

            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="25">

                    <!-- HERO HEADER -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,40,0,10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Welcome back,"
                                   FontSize="22"
                                   TextColor="#A1A1AA"/>

                            <Label Text="{Binding UserName}"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                        </VerticalStackLayout>

                        <Image Grid.Column="1"
                               Source="sun_icon.png"
                               HeightRequest="40"
                               VerticalOptions="Center"
                               Opacity="0.85"/>
                    </Grid>

                    <!-- STATS CARDS -->
                    <Grid x:Name="StatsContainer"
                          ColumnDefinitions="*, *"
                           RowDefinitions="Auto, Auto, Auto"
                           ColumnSpacing="15"
                           RowSpacing="15">

                        <!-- Total Events -->
                        <Border Grid.Row="0" Grid.Column="0"
            Style="{StaticResource StatsCardStyle}"
            BackgroundColor="{StaticResource PrimaryPurple}">
                            <VerticalStackLayout Spacing="5">
                                <Image Source="users_white.png"
                   HorizontalOptions="Start"
                   HeightRequest="24"/>
                                <Label Text="{Binding TotalEventsCount}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"/>
                                <Label Text="Total Events"
                   TextColor="White"
                   FontSize="12"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Confirmed -->
                        <Border Grid.Row="0" Grid.Column="1"
            Style="{StaticResource StatsCardStyle}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0.0"/>
                                    <GradientStop Color="#059669" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <VerticalStackLayout Spacing="5">
                                <Image Source="check_circle_white.png"
                   HeightRequest="24"/>
                                <Label Text="{Binding ConfirmedCount}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"/>
                                <Label Text="Confirmed"
                   TextColor="#E5E7EB"
                   FontSize="12"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Tentative -->
                        <Border Grid.Row="1" Grid.Column="0"
            Style="{StaticResource StatsCardStyle}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0.0"/>
                                    <GradientStop Color="#D97706" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <VerticalStackLayout Spacing="5">
                                <Image Source="clock_small.png"
                   HeightRequest="24"/>
                                <Label Text="{Binding TentativeCount}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"/>
                                <Label Text="Tentative"
                   TextColor="#FFF7ED"
                   FontSize="12"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Declined -->
                        <Border Grid.Row="1" Grid.Column="1"
            Style="{StaticResource StatsCardStyle}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0.0"/>
                                    <GradientStop Color="#B91C1C" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <VerticalStackLayout Spacing="5">
                                <Image Source="close_white.png"
                   HeightRequest="24"/>
                                <Label Text="{Binding DeclinedCount}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"/>
                                <Label Text="Declined"
                   TextColor="#FEE2E2"
                   FontSize="12"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Pending (full width) -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
            Style="{StaticResource StatsCardStyle}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0.0"/>
                                    <GradientStop Color="#4F46E5" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <VerticalStackLayout Spacing="5">
                                <Image Source="hourglass_white.png"
                   HeightRequest="24"/>
                                <Label Text="{Binding PendingCount}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"/>
                                <Label Text="Pending"
                   TextColor="#E0E7FF"
                   FontSize="12"/>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <!-- SECTION HEADER -->
                    <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                        <Label Text="Upcoming Events"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="#2D2D3A"
                                 VerticalOptions="Center"
                                 HorizontalOptions="FillAndExpand"/>
                    </HorizontalStackLayout>

                    <!-- EVENTS LIST -->
                    <CollectionView ItemsSource="{Binding Events}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="15"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:EventResponse">
                                <Border StrokeShape="RoundRectangle 20"
                                        BackgroundColor="#1E1E2E"
                                        Padding="20"
                                        Shadow="{StaticResource ShadowLarge}">

                                    <VerticalStackLayout Spacing="12">

                                        <!-- Title + Type -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   LineBreakMode="TailTruncation"/>

                                            <Border Grid.Column="1"
                                                    BackgroundColor="#2D2D3A"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="8,4">
                                                <Label Text="{Binding Type}"
                                                       TextColor="{StaticResource PrimaryPurple}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Date + Time -->
                                        <HorizontalStackLayout Spacing="10">
                                            <Image Source="calendar_small.png" HeightRequest="14"/>
                                            <Label Text="{Binding EventDate, StringFormat='{0:dd MMM yyyy}'}"
                                                   TextColor="White"
                                                   FontSize="13"/>

                                            <Label Text="•" TextColor="#6B7280" FontSize="13"/>

                                            <Image Source="clock_small.png" HeightRequest="14"/>
                                            <Label Text="{Binding EventDate, StringFormat='{0:hh:mm tt}'}"
                                                   TextColor="#9CA3AF"
                                                   FontSize="13"/>
                                        </HorizontalStackLayout>

                                        <!-- Location -->
                                        <HorizontalStackLayout Spacing="10">
                                            <Image Source="location_small.png" HeightRequest="14"/>
                                            <Label Text="{Binding Location}"
                                                   TextColor="#9CA3AF"
                                                   FontSize="13"
                                                   LineBreakMode="TailTruncation"/>
                                        </HorizontalStackLayout>

                                        <BoxView HeightRequest="1" Color="#2D2D3A"/>

                                        <!-- RSVP + Status -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <HorizontalStackLayout Spacing="8">
                                                <Image Source="check_green_small.png" HeightRequest="12"/>
                                                <Label Text="{Binding ConfirmedCount, StringFormat='{0} confirmed'}"
                                                       TextColor="#9CA3AF"
                                                       FontSize="12"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="Status:" TextColor="#64748B" FontSize="12"/>
                                                <Label Text="Active"
                                                       TextColor="{StaticResource SuccessGreen}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- FLOATING ACTION BUTTON -->
        <Border x:Name="FabBorder"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                HeightRequest="60"
                WidthRequest="60"
                Padding="15,0"
                BackgroundColor="{StaticResource PrimaryPurple}"
                StrokeShape="RoundRectangle 30"
                IsVisible="{Binding IsAdmin}"
                Shadow="{StaticResource ShadowLarge}">

            <Border.GestureRecognizers>
                <PointerGestureRecognizer PointerEntered="OnFabHoverEntered"
                                          PointerExited="OnFabHoverExited"/>
                <TapGestureRecognizer Tapped="OnCreateEventClicked"/>
            </Border.GestureRecognizers>

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="+" FontSize="28" TextColor="White"/>
                <Label Text="Create New Event"
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold"
                       IsVisible="{Binding IsFabExpanded}"/>
            </HorizontalStackLayout>

        </Border>

    </Grid>
</ContentPage>