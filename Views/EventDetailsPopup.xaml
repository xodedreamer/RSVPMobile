<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:models="clr-namespace:RSVPMobile.Models"
               x:Class="RSVPMobile.Views.EventDetailsPopup"
               x:DataType="models:UserEventRsvpResponse"
               BackgroundColor="#1A1A24"
               DesiredSize="350,450">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="{Binding Title}" 
               FontSize="22" 
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"/>

        <Label Text="{Binding EventDate, StringFormat='Date: {0:MMMM dd, yyyy}'}"
               TextColor="White"/>

        <Label Text="{Binding Location, StringFormat='Location: {0}'}"
               TextColor="White"/>

        <Label Text="{Binding Description}"
               TextColor="White"
               LineBreakMode="WordWrap"/>

        <VerticalStackLayout Spacing="10">

            <Button Text="Accept"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="Accept_Clicked"/>

            <Button Text="Tentative"
                    BackgroundColor="#FFC107"
                    TextColor="Black"
                    CornerRadius="10"
                    Clicked="Tentative_Clicked"/>

            <Button Text="Decline"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="Decline_Clicked"/>

            <Button Text="Close"
                    BackgroundColor="#555"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="Close_Clicked"/>

        </VerticalStackLayout>

    </VerticalStackLayout>
</toolkit:Popup>