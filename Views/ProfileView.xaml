<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPMobile.Views.ProfileView"
             Title="ProfileView" 
             Shell.NavBarIsVisible="False" 
             BackgroundColor="{StaticResource BackgroundDark}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            <Label Text="Profile" FontSize="28" FontAttributes="Bold" TextColor="White"/>

            <Border Style="{StaticResource ProfileHeaderStyle}">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 50" HeightRequest="100" WidthRequest="100" HorizontalOptions="Center">
                        <Image Source="sarah_portrait.png" Aspect="AspectFill"/>
                    </Border>
                    <Label Text="Sarah Johnson" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Member since January 2024" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center"/>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderDark}" Margin="0,10"/>

                    <HorizontalStackLayout Spacing="10">
                        <Image Source="mail_purple.png" HeightRequest="18"/>
                        <Label Text="sarah.johnson@example.com" TextColor="White"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="phone_purple.png" HeightRequest="18"/>
                        <Label Text="+1 (555) 123-4567" TextColor="White"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <Border Style="{StaticResource StatsCardStyle}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="12" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Total Events" TextColor="{StaticResource SecondaryText}" FontSize="10"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatsCardStyle}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="3" TextColor="{StaticResource PrimaryPurple}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Upcoming" TextColor="{StaticResource SecondaryText}" FontSize="10"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatsCardStyle}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="9" TextColor="#10B981" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Attended" TextColor="{StaticResource SecondaryText}" FontSize="10"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Upcoming Events" TextColor="White" FontSize="18" FontAttributes="Bold"/>

            <Border Style="{StaticResource StatsCardStyle}" Padding="10">
                <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="12">
                    <Border StrokeShape="RoundRectangle 8" HeightRequest="60">
                        <Image Source="fashion_gala_thumb.png" Aspect="AspectFill"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Fashion Week..." TextColor="White" FontAttributes="Bold"/>
                        <Label Text="March 15, 2025" TextColor="{StaticResource SecondaryText}" FontSize="12"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Stroke="{StaticResource SuccessGreen}" StrokeShape="RoundRectangle 10" Padding="8,2" VerticalOptions="Center">
                        <Label Text="Confirmed" TextColor="{StaticResource SuccessGreen}" FontSize="10"/>
                    </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>