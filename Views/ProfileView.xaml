<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPMobile.Views.ProfileView"
             Title="ProfileView" 
             Shell.NavBarIsVisible="False" 
             BackgroundColor="{StaticResource BackgroundDark}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- Page Title -->
            <Label Text="Profile"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"/>

            <!-- Profile Header -->
            <Border Style="{StaticResource ProfileHeaderStyle}">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

                    <!-- Avatar -->
                    <Border StrokeShape="RoundRectangle 50"
                            HeightRequest="100"
                            WidthRequest="100"
                            HorizontalOptions="Center">
                        <Image Source="user_icon.png"
                               Aspect="AspectFill"/>
                    </Border>

                    <!-- User Name -->
                    <Label Text="{Binding UserName}"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <!-- Member Since -->
                    <Label Text="{Binding MemberSince}"
                           TextColor="{StaticResource SecondaryText}"
                           HorizontalOptions="Center"/>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource BorderDark}"
                             Margin="0,10"/>

                    <!-- Email -->
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="mail_purple.png" HeightRequest="18"/>
                        <Label Text="{Binding Email}"
                               TextColor="White"/>
                    </HorizontalStackLayout>

                    <!-- Phone -->
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="phone_purple.png" HeightRequest="18"/>
                        <Label Text="{Binding PhoneNumber}"
                               TextColor="White"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Stats -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">

                <Border Style="{StaticResource StatsCardStyle}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding TotalEvents}"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Total Events"
                               TextColor="{StaticResource SecondaryText}"
                               FontSize="10"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatsCardStyle}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding UpcomingEvents}"
                               TextColor="{StaticResource PrimaryPurple}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Upcoming"
                               TextColor="{StaticResource SecondaryText}"
                               FontSize="10"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatsCardStyle}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding AttendedEvents}"
                               TextColor="#10B981"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Attended"
                               TextColor="{StaticResource SecondaryText}"
                               FontSize="10"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Logout -->
            <Button Text="Logout"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="#EF4444" 
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    Margin="20"
                    VerticalOptions="End" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>