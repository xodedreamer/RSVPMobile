<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:RSVPMobile.Models"
             xmlns:vm="clr-namespace:RSVPMobile.ViewModels"
             x:Class="RSVPMobile.Views.RSVPView"
             Title="RSVPView"
             BackgroundColor="{StaticResource BackgroundDark}"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:RSVPViewModel">

    <Grid RowDefinitions="*">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="25">

                <Label Text="Event RSVP" FontSize="28" FontAttributes="Bold" TextColor="White"/>
                <Label Text="Confirm your attendance for upcoming events" TextColor="{StaticResource SecondaryText}" Margin="0,-15,0,0"/>

                <Border Style="{StaticResource InputBorderStyle}" Padding="5,0">
                    <SearchBar Placeholder="Search events by name or location..."
                               PlaceholderColor="#4B5563"
                               TextColor="White"
                               Text="{Binding SearchText, Mode=TwoWay}">
                        <SearchBar.Behaviors>
                            <toolkit:EventToCommandBehavior EventName="TextChanged" Command="{Binding ApplyFilterCommand}"/>
                        </SearchBar.Behaviors>
                    </SearchBar>
                </Border>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" HeightRequest="45">
                    <Button Text="Pending Invites" Command="{Binding FilterPendingCommand}" TextColor="White" CornerRadius="8">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowConfirmed}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryPurple}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowConfirmed}" Value="True">
                                <Setter Property="BackgroundColor" Value="#1E1E2E" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Grid.Column="1" Text="Confirmed" Command="{Binding FilterConfirmedCommand}" TextColor="White" CornerRadius="8">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowConfirmed}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryPurple}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowConfirmed}" Value="False">
                                <Setter Property="BackgroundColor" Value="#1E1E2E" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <Label Text="Your Feeds" FontSize="20" FontAttributes="Bold" TextColor="White"/>

                <CollectionView ItemsSource="{Binding FilteredEvents}" 
                                SelectionMode="Single"
                                SelectionChangedCommand="{Binding ShowEventDetailsCommand}"
                                SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30">
                            <Label Text="No events found matching criteria." TextColor="{StaticResource SecondaryText}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserEventRsvpResponse">
                            <Border Style="{StaticResource StatsCardStyle}" Padding="15" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="60, *, Auto" ColumnSpacing="15">

                                    <Border StrokeShape="RoundRectangle 12" HeightRequest="60" WidthRequest="60">
                                        <Image Source="{Binding ImageUrl, FallbackValue='tech_conf_thumb.png'}" Aspect="AspectFill"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding EventDate, StringFormat='{0:MMMM dd, yyyy}'}" TextColor="{StaticResource SecondaryText}" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2" 
                                            VerticalOptions="Center"
                                            Stroke="{Binding IsConfirmed, Converter={StaticResource StatusColorConverter}}" 
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" 
                                            Padding="12,6"
                                            BackgroundColor="#0D10B981">
                                        <Label Text="{Binding IsConfirmed, Converter={StaticResource StatusTextConverter}}" 
                                               TextColor="{Binding IsConfirmed, Converter={StaticResource StatusColorConverter}}" 
                                               FontSize="12" 
                                               FontAttributes="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>