<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RSVPMobile.ViewModels"
             x:Class="RSVPMobile.Views.SignupView"
             x:DataType="vm:SignupViewModel"
             Title="SignupView"
             BackgroundColor="{StaticResource BackgroundDark}"
             
             NavigationPage.HasNavigationBar="False">
    
    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="30">

            <Label Text="Create Account" TextColor="White" FontSize="32" FontAttributes="Bold" />
            <Label Text="Join us to manage events" TextColor="{StaticResource SecondaryText}" />

            <Label Text="Select Role" TextColor="White" FontAttributes="Bold" Margin="0,10,0,0" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Border x:Name="AttendeeCard" Grid.Column="0" Style="{StaticResource SelectableRoleStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRoleTapped" CommandParameter="Attendee" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Image Source="user_icon.png" HeightRequest="28" />
                        <Label Text="Attendee" HorizontalOptions="Center" TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="AdminCard" Grid.Column="1" Style="{StaticResource SelectableRoleStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRoleTapped" CommandParameter="Admin" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Image Source="admin_check_icon.png" HeightRequest="28" />
                        <Label Text="Admin" HorizontalOptions="Center" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            
            <VerticalStackLayout Spacing="15">
                <!-- Full Name -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Full Name" TextColor="White" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding FullName, Mode=TwoWay}" 
                   Placeholder="John Doe" 
                   PlaceholderColor="#4B5563" 
                   TextColor="White" />
                    </Border>
                </VerticalStackLayout>

                <!-- Email -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Email" TextColor="White" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding Email, Mode=TwoWay}" 
                   Placeholder="john@example.com" 
                   PlaceholderColor="#4B5563" 
                   TextColor="White" 
                   Keyboard="Email"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Password -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Password" TextColor="White" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding Password, Mode=TwoWay}" 
                   IsPassword="True" 
                   Placeholder="Enter password" 
                   TextColor="White" />
                    </Border>
                </VerticalStackLayout>

                <!-- Confirm Password -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Confirm Password" TextColor="White" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding ConfirmPassword, Mode=TwoWay}" 
                   IsPassword="True" 
                   Placeholder="Confirm password" 
                   TextColor="White" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Sign Up Button -->
            <Button Text="Sign Up" 
                Style="{StaticResource PrimaryButtonStyle}" 
                Command="{Binding SignupCommand}" 
                IsEnabled="{Binding IsNotBusy}"
                Margin="0,10" />

            <Label HorizontalTextAlignment="Center" FontSize="11" TextColor="{StaticResource SecondaryText}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="By signing up, you agree to our " />
                        <Span Text="Terms of Service" TextColor="{StaticResource PrimaryPurple}" />
                        <Span Text=" and " />
                        <Span Text="Privacy Policy" TextColor="{StaticResource PrimaryPurple}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                IsVisible="{Binding IsBusy}" 
                Color="{StaticResource PrimaryPurple}" 
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>